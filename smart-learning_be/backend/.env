CHROMA_BATCH=128

# Chunking
CHUNK_SIZE=1000
CHUNK_OVERLAP=120

# LLM (optional; để trống => không dùng)
GOOGLE_API_KEY=AIzaSyBqOsBv2xrAxtsKSukHQAHtkvl5r2Zn4-Q
LLM_PROVIDER=gemini
GEMINI_MODEL=gemini-1.5-flash 
OLLAMA_MODEL=llama3.1:8b-instruct

# Reranker 
RERANKER_MODE=off          # nhanh nhất
