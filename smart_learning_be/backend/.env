HF_HUB_ENABLE_HF_TRANSFER=1
TRANSFORMERS_SAFE_WEIGHTS=1
TORCH_CUDA_ALLOC_CONF=max_split_size_mb:128
HF_HUB_CACHE=./.cache/huggingface

ENABLE_SEMANTIC_TAGGER=true
