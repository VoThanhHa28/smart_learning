GOOGLE_APPLICATION_CREDENTIALS=/app/firebase_key.json
FIREBASE_STORAGE_BUCKET=<your-bucket>.appspot.com

LANGCHAIN_API_KEY=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
LANGCHAIN_PROJECT=edu-chatbot

# Chunking
CHUNK_SIZE=1000
CHUNK_OVERLAP=120

# LLM (optional; để trống => không dùng)
GOOGLE_API_KEY=AIzaSyBqOsBv2xrAxtsKSukHQAHtkvl5r2Zn4-Q
LLM_PROVIDER=gemini
GEMINI_MODEL=gemini-2.0-flash
# LLM_PROVIDER=ollama
# Reranker    

# Embeddings (FREE)
USE_BM25=true
USE_DOCLING=true
USE_APPENDIX=false
RERANKER_MODE=base
EMBED_MODEL=intfloat/multilingual-e5-base
RERANK_MODEL=BAAI/bge-reranker-base
RERANK_THRESHOLD = 0.5
LOCAL_MODEL=adrienbrault/nous-hermes2pro:Q4_K_S-json
HF_TOKEN=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
EMBED_BATCH=64
PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True,max_split_size_mb:64
FINAL_TOP_N=8
MAX_INTENTS=2

HF_HUB_ENABLE_HF_TRANSFER=1
TRANSFORMERS_SAFE_WEIGHTS=1
HF_HUB_CACHE=./.cache/huggingface

ENABLE_SEMANTIC_TAGGER=true
OCR_DEVICE=gpu
NO_GRAPH_CACHE=true

# Milvus
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_COLLECTION=smart_learning


DEBUG_TAGGER=1

# Rerank
RERANK_PREVIEW=1
RERANK_PREVIEW_WINDOW=550    # bán kính ± ký tự quanh hit (400–600 là hợp lý)
RERANK_PREVIEW_HEAD=1200
RERANK_PREVIEW_TAIL=800
RERANK_PREVIEW_MID=800


PYTHONPATH=backend
