# ==== GCP / Firebase ====
GOOGLE_APPLICATION_CREDENTIALS=/app/firebase_key.json
FIREBASE_STORAGE_BUCKET=your-bucket.appspot.com

# ==== LangChain ====
LANGCHAIN_API_KEY=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
LANGCHAIN_PROJECT=edu-chatbot

# ==== Chunking ====
CHUNK_SIZE=1000
CHUNK_OVERLAP=120

# ==== LLM (chọn 1) ====
LLM_PROVIDER=gemini
GOOGLE_API_KEY=AIzaSyBqOsBv2xrAxtsKSukHQAHtkvl5r2Zn4-Q
GEMINI_MODEL=gemini-2.0-flash
# Hoặc:
# LLM_PROVIDER=ollama
# LOCAL_MODEL=adrienbrault/nous-hermes2pro:Q4_K_S-json

# ==== Embedding / Rerank ====
USE_BM25=true
USE_DOCLING=true
USE_APPENDIX=false
EMBED_MODEL=intfloat/multilingual-e5-base
EMBED_BATCH=64

RERANKER_MODE=base
RERANK_MODEL=BAAI/bge-reranker-base
RERANK_THRESHOLD=0.5
FINAL_TOP_N=8
MAX_INTENTS=2

# ==== HuggingFace / Transformers ====
HF_TOKEN=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
HF_HUB_ENABLE_HF_TRANSFER=1
TRANSFORMERS_SAFE_WEIGHTS=1
HF_HUB_CACHE=./.cache/huggingface

# ==== Feature Flags ====
ENABLE_SEMANTIC_TAGGER=true
OCR_DEVICE=gpu
NO_GRAPH_CACHE=true
DEBUG_TAGGER=0

# ==== Milvus ====
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_COLLECTION=smart_learning

# ==== Rerank preview (debug) ====
RERANK_PREVIEW=0
RERANK_PREVIEW_WINDOW=550
RERANK_PREVIEW_HEAD=1200
RERANK_PREVIEW_TAIL=800
RERANK_PREVIEW_MID=800

# ==== RAG fan-out ====
RAG_SUBQ_CONCURRENCY=2
RAG_RRF_INTERQUERY_K=64
RAG_RRF_INTERQUERY_TOPN=50
RAG_QUOTA_MIN_PER_SUBQ=2
RAG_MAX_SUBQS_SQ=4

# ==== Misc ====
PYTHONPATH=backend
